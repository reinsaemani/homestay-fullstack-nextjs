generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Booking {
  id            String        @id @db.Uuid
  displayId     Int           @unique @default(autoincrement())
  guestName     String
  phoneNumber   String
  city          String?
  checkIn       DateTime
  checkOut      DateTime
  pricePerNight Decimal       @db.Decimal(12, 2)
  totalPrice    Decimal       @db.Decimal(12, 2)
  downPayment   Decimal       @db.Decimal(12, 2)
  status        BookingStatus @default(BOOKED)
  note          String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now())
}

model PiggyBank {
  id          String   @id @db.Uuid
  description String
  amount      Decimal  @db.Decimal(12, 2)
  type        String   @default("IN") // IN or OUT
  createdAt   DateTime @default(now())
}

model User {
  id        String   @id @db.Uuid
  name      String
  email     String   @unique
  password  String

  role      UserRole @default(ADMIN)

  createdAt DateTime @default(now())
  updatedAt DateTime
}

enum BookingStatus {
  BOOKED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
}

